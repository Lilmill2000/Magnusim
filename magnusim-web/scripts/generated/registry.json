    {
      "key": "velocity_inlet_mass",
      "label": "Velocity inlet",
      "plugin": "builtin",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mass_flow_kg_s": {
            "type": "number",
            "default": 0.0,
