{
  "analysis": [
    {
      "key": "incompressible_steady",
      "label": "Incompressible Fluid Flow",
      "plugin": "incompressible_flow",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "turbulence_model": {
            "type": "string",
            "default": "kOmegaSST",
            "enum": [
              "laminar",
              "kEpsilon",
              "kOmegaSST",
              "LRR",
              "SSG"
            ],
            "x-cfddesk": {
              "group": "flow",
              "enum_labels": [
                "Laminar",
                "k-epsilon",
                "k-omega SST",
                "LRR (Reynolds stress)",
                "SSG (Reynolds stress)"
              ]
            },
            "title": "Turbulence model",
            "description": "Which turbulence closure the solver uses. k-omega SST is the general-purpose default and handles walls at any y+. k-epsilon and the Reynolds-stress models (LRR, SSG) use high-Re wall functions (y+ above about 30). Reynolds-stress models suit strong swirl but may need a converged k-epsilon run first. Laminar solves no turbulence at all."
          }
        },
        "additionalProperties": false
      },
      "numerics_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "residual_u": {
            "type": "number",
            "default": 0.0001,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "residuals"
            },
            "title": "Residual U",
            "description": "Convergence target for the velocity and turbulence equations. The run stops early once every residual is below its target; otherwise it runs to the iteration limit."
          },
          "residual_p": {
            "type": "number",
            "default": 0.0001,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "residuals"
            },
            "title": "Residual p",
            "description": "Convergence target for the pressure equation. The run stops early once every residual is below its target."
          },
          "relax_u": {
            "type": "number",
            "default": 0.7,
            "minimum": 0.0,
            "maximum": 1.0,
            "x-cfddesk": {
              "group": "relaxation"
            },
            "title": "Relaxation U",
            "description": "Under-relaxation for the velocity and turbulence equations (0 to 1). Lower is more stable but converges more slowly. Reynolds-stress models (LRR, SSG) start at 0.5."
          },
          "relax_p": {
            "type": "number",
            "default": 0.3,
            "minimum": 0.0,
            "maximum": 1.0,
            "x-cfddesk": {
              "group": "relaxation"
            },
            "title": "Relaxation p",
            "description": "Under-relaxation for pressure (0 to 1). SIMPLE usually needs about 0.3; lower it if the solve oscillates or diverges."
          },
          "n_non_orthogonal": {
            "type": "integer",
            "default": 3,
            "minimum": 0,
            "maximum": 20,
            "x-cfddesk": {
              "group": "solution"
            },
            "title": "Non-orthogonal correctors",
            "description": "Extra pressure corrections per iteration for skewed or non-orthogonal cells. 0 is enough for clean hex meshes; tetrahedral meshes usually need 1 to 3."
          }
        },
        "additionalProperties": false
      },
      "control_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "end_time": {
            "type": "integer",
            "default": 200,
            "minimum": 1,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Number of iterations",
            "description": "Iterations to run. The run stops earlier when the residuals reach their targets."
          },
          "write_interval": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Write interval",
            "description": "How often results are saved, in iterations."
          }
        },
        "additionalProperties": false
      },
      "requires": [
        {
          "kind": "wsl_tool",
          "name": "simpleFoam",
          "version_spec": ""
        }
      ],
      "time_dependency": "steady",
      "default_turbulence": "kOmegaSST",
      "default_solver": "simpleFoam",
      "category": "FLUID DYNAMICS",
      "turbulence_models": [
        "laminar",
        "kEpsilon",
        "kOmegaSST",
        "LRR",
        "SSG"
      ],
      "contract": "1.1",
      "family": {
        "key": "incompressible",
        "label": "Incompressible",
        "title": "Incompressible Fluid Flow",
        "description": "Simulate flow of a single fluid for which the maximum Mach number is lower than 0.3. Density variations are negligible \u2014 approximated as incompressible.",
        "tags": [
          "FLUID FLOW (GAS OR LIQUID)",
          "MACH<0.3 (100 M/S)",
          "NEGLIGIBLE DENSITY VARIATION"
        ],
        "study_name": "Incompressible"
      },
      "algorithm_label": "SIMPLE",
      "residual_keys": [
        "U",
        "p",
        "k",
        "omega",
        "epsilon",
        "R"
      ],
      "x_axis": "iterations",
      "result_fields": [
        {
          "key": "U",
          "label": "Velocity",
          "unit_quantity": "velocity",
          "kind": "vector"
        },
        {
          "key": "p",
          "label": "Pressure",
          "unit_quantity": "pressure",
          "kind": "scalar"
        },
        {
          "key": "k",
          "label": "Turbulent kinetic energy",
          "unit_quantity": "specific_energy",
          "kind": "scalar"
        },
        {
          "key": "omega",
          "label": "Specific dissipation rate",
          "unit_quantity": "specific_dissipation_rate",
          "kind": "scalar"
        },
        {
          "key": "nut",
          "label": "Turbulent viscosity",
          "unit_quantity": "kinematic_viscosity",
          "kind": "scalar"
        }
      ],
      "ui": {
        "study_panel": "SimulationPanel",
        "run_panel": "RunControl"
      },
      "study_defaults": {
        "analysis_type": "incompressible_steady",
        "analysis": "Incompressible",
        "analysis_title": "Incompressible Fluid Flow",
        "category": "FLUID DYNAMICS",
        "flow_group": "FLOW",
        "turbulence_model_key": "kOmegaSST",
        "turbulence_model": "k-omega SST",
        "time_dependency": "Steady-state",
        "algorithm": "SIMPLE"
      },
      "run_defaults": {
        "end_time": 200,
        "write_interval": 50
      }
    },
    {
      "key": "incompressible_transient",
      "label": "Incompressible Fluid Flow (Transient)",
      "plugin": "incompressible_flow",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "turbulence_model": {
            "type": "string",
            "default": "kOmegaSST",
            "enum": [
              "laminar",
              "kEpsilon",
              "kOmegaSST",
              "LRR",
              "SSG"
            ],
            "x-cfddesk": {
              "group": "flow",
              "enum_labels": [
                "Laminar",
                "k-epsilon",
                "k-omega SST",
                "LRR (Reynolds stress)",
                "SSG (Reynolds stress)"
              ]
            },
            "title": "Turbulence model",
            "description": "Which turbulence closure the solver uses. k-omega SST is the general-purpose default and handles walls at any y+. k-epsilon and the Reynolds-stress models (LRR, SSG) use high-Re wall functions (y+ above about 30). Reynolds-stress models suit strong swirl but may need a converged k-epsilon run first. Laminar solves no turbulence at all."
          }
        },
        "additionalProperties": false
      },
      "numerics_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "control_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "end_time": {
            "type": "number",
            "default": 5.0,
            "minimum": 0.0,
            "x-cfddesk": {
              "unit": "s",
              "group": "control"
            },
            "title": "Simulation time",
            "description": "Simulated time to stop at, in seconds."
          },
          "write_count": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 5000,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Result frames",
            "description": "Result frames saved over the simulation time."
          },
          "time_step_mode": {
            "type": "string",
            "default": "adjustable",
            "enum": [
              "adjustable",
              "fixed"
            ],
            "x-cfddesk": {
              "group": "control",
              "advanced": true,
              "enum_labels": [
                "Adjustable",
                "Fixed"
              ]
            },
            "title": "Time step",
            "description": "Adjustable keeps the Courant number at or below the maximum; fixed uses one step throughout."
          },
          "max_co": {
            "type": "number",
            "default": 1.0,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "control",
              "advanced": true
            },
            "title": "Max Courant",
            "description": "Largest Courant number allowed when the time step adjusts: how many cells flow may cross in one step. Keep at or below 1 for stability."
          },
          "delta_t": {
            "type": "number",
            "default": null,
            "minimum": 0.0,
            "x-cfddesk": {
              "unit": "s",
              "group": "control",
              "advanced": true,
              "optional": true
            },
            "title": "Initial time step",
            "description": "Blank calculates it from the smallest cell and the inlet speed."
          },
          "max_delta_t": {
            "type": "number",
            "default": null,
            "minimum": 0.0,
            "x-cfddesk": {
              "unit": "s",
              "group": "control",
              "advanced": true,
              "optional": true
            },
            "title": "Max time step",
            "description": "Blank uses the frame interval, so every frame is written."
          },
          "time_scheme": {
            "type": "string",
            "default": "Euler",
            "enum": [
              "Euler",
              "backward"
            ],
            "x-cfddesk": {
              "group": "control",
              "advanced": true,
              "enum_labels": [
                "Euler (1st order)",
                "Backward (2nd order)"
              ]
            },
            "title": "Time scheme",
            "description": "Euler is robust; backward is more accurate in time."
          },
          "n_outer_correctors": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "maximum": 50,
            "x-cfddesk": {
              "group": "control",
              "advanced": true
            },
            "title": "Outer correctors",
            "description": "PIMPLE outer loops per time step. 1 is PISO mode."
          },
          "n_correctors": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "maximum": 10,
            "x-cfddesk": {
              "group": "control",
              "advanced": true
            },
            "title": "Pressure correctors",
            "description": "Pressure corrections per outer loop."
          },
          "n_non_orth_correctors": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 5,
            "x-cfddesk": {
              "group": "control",
              "advanced": true
            },
            "title": "Non-orthogonal correctors",
            "description": "Extra pressure corrections for skewed or non-orthogonal cells."
          }
        },
        "additionalProperties": false
      },
      "requires": [
        {
          "kind": "wsl_tool",
          "name": "pimpleFoam",
          "version_spec": ""
        }
      ],
      "time_dependency": "transient",
      "default_turbulence": "kOmegaSST",
      "default_solver": "pimpleFoam",
      "category": "FLUID DYNAMICS",
      "turbulence_models": [
        "laminar",
        "kEpsilon",
        "kOmegaSST",
        "LRR",
        "SSG"
      ],
      "contract": "1.1",
      "family": {
        "key": "incompressible",
        "label": "Incompressible",
        "title": "Incompressible Fluid Flow",
        "description": "Simulate flow of a single fluid for which the maximum Mach number is lower than 0.3. Density variations are negligible \u2014 approximated as incompressible.",
        "tags": [
          "FLUID FLOW (GAS OR LIQUID)",
          "MACH<0.3 (100 M/S)",
          "NEGLIGIBLE DENSITY VARIATION"
        ],
        "study_name": "Incompressible"
      },
      "algorithm_label": "PIMPLE",
      "residual_keys": [
        "U",
        "p",
        "k",
        "omega",
        "epsilon",
        "R"
      ],
      "x_axis": "seconds",
      "result_fields": [
        {
          "key": "U",
          "label": "Velocity",
          "unit_quantity": "velocity",
          "kind": "vector"
        },
        {
          "key": "p",
          "label": "Pressure",
          "unit_quantity": "pressure",
          "kind": "scalar"
        },
        {
          "key": "k",
          "label": "Turbulent kinetic energy",
          "unit_quantity": "specific_energy",
          "kind": "scalar"
        },
        {
          "key": "omega",
          "label": "Specific dissipation rate",
          "unit_quantity": "specific_dissipation_rate",
          "kind": "scalar"
        },
        {
          "key": "nut",
          "label": "Turbulent viscosity",
          "unit_quantity": "kinematic_viscosity",
          "kind": "scalar"
        }
      ],
      "ui": {
        "study_panel": "SimulationPanel",
        "run_panel": "RunControl"
      },
      "study_defaults": {
        "analysis_type": "incompressible_transient",
        "analysis": "Incompressible",
        "analysis_title": "Incompressible Fluid Flow",
        "category": "FLUID DYNAMICS",
        "flow_group": "FLOW",
        "turbulence_model_key": "kOmegaSST",
        "turbulence_model": "k-omega SST",
        "time_dependency": "Transient",
        "algorithm": "PIMPLE"
      },
      "run_defaults": {
        "end_time": 5.0,
        "write_count": 50,
        "time_step_mode": "adjustable",
        "max_co": 1.0,
        "delta_t": null,
        "max_delta_t": null,
        "time_scheme": "Euler",
        "n_outer_correctors": 1,
        "n_correctors": 2,
        "n_non_orth_correctors": 0
      }
    }
  ],
