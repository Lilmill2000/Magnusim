    { "row": "R23", "editions": ["magnusim"], "notes": "A run that ended: changing a stopped or failed run's solve settings, or its Start, starts it over (asked first when it has results, which are deleted); a finished run keeps its results and a change goes to a new run with its settings (its Cores, settle stop and Copy settings from stay as they are, as in the panel); read_setup says which (settings); a run that became unhealthy: Start's question and the run_start card carry the same health sentence (overwriteWords, RH1)", "paths": [{ "tool": "setup_edit", "where": { "kind": "run", "action": ["update", "copy_from"] }, "routes": ["run.update"] }, { "tool": "compute", "where": { "action": "run_start" }, "routes": ["run.reopen", "run.start"] }, { "tool": "setup_edit", "where": { "kind": "run", "action": "add" }, "routes": ["run.create", "run.update"] }, { "tool": "read_setup", "where": { "what": ["runs", "run"] }, "routes": ["run.status"] }] },
