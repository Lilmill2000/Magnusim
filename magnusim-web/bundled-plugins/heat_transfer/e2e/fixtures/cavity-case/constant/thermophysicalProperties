FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie          { molWeight 28.97; }
    thermodynamics  { Cp 1000; Hf 0; }
    transport       { mu 2.639e-05; Pr 0.70998117; }
    equationOfState { rho0 1; T0 298.15; beta 0.001; }
}
