FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie          { molWeight 1; }
    transport       { kappa 167; }
    thermodynamics  { Cp 896; Hf 0; }
    equationOfState { rho 2700; }
}
