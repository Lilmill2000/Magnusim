FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
        maxIter         200;
    }
    "(U|h|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    momentumPredictor yes;
    nNonOrthogonalCorrectors 1;
    pRefCell        0;
    pRefValue       0;
    residualControl { p_rgh 1e-05; U 1e-05; h 1e-05; "(k|omega)" 0.0001; }
}

relaxationFactors
{
    fields
    {
        rho             1;
        p_rgh           0.3;
    }
    equations
    {
        U               0.7;
        h               0.5;
        "(k|omega)" 0.7;
    }
}
