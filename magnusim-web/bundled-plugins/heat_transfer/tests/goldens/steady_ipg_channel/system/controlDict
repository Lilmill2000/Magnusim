FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     buoyantSimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         500;
deltaT          1;
writeControl    timeStep;
writeInterval   100;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    ht_wall_heat_flux
    {
        type            wallHeatFlux;
        libs            (fieldFunctionObjects);
        patches         ( walls heater cold_plate lid );
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
        log             false;
    }
    ht_htc_raw
    {
        type            heatTransferCoeff;
        libs            (fieldFunctionObjects);
        field           T;
        patches         ( walls heater cold_plate lid );
        htcModel        fixedReferenceTemperature;
        TRef            293.15;
        result          htcRaw;
        writeControl    none;
        log             false;
    }
    ht_htc
    {
        type            reference;
        libs            (fieldFunctionObjects);
        field           htcRaw;
        refValue        constant 0;
        scale           -1;
        result          htc;
        writeControl    writeTime;
        log             false;
    }
    ht_rho
    {
        type            writeObjects;
        libs            (utilityFunctionObjects);
        objects         ( rho );
        writeOption     anyWrite;
        writeControl    writeTime;
    }
    ht_enthalpy_inlet
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        regionType      patch;
        name            inlet;
        operation       weightedSum;
        weightField     phi;
        fields          ( h );
    }
    ht_enthalpy_outlet
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        regionType      patch;
        name            outlet;
        operation       weightedSum;
        weightField     phi;
        fields          ( h );
    }
    ht_Tavg_heater
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        regionType      patch;
        name            heater;
        operation       areaAverage;
        fields          ( T );
    }
    ht_Tmax_heater
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        regionType      patch;
        name            heater;
        operation       max;
        fields          ( T );
    }
    ht_Tavg_cold_plate
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        regionType      patch;
        name            cold_plate;
        operation       areaAverage;
        fields          ( T );
    }
    ht_Tmax_cold_plate
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        regionType      patch;
        name            cold_plate;
        operation       max;
        fields          ( T );
    }
    ht_Tavg_walls
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        regionType      patch;
        name            walls;
        operation       areaAverage;
        fields          ( T );
    }
    ht_Tmax_walls
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        regionType      patch;
        name            walls;
        operation       max;
        fields          ( T );
    }
    ht_probe_thermocouple_1
    {
        type            probes;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        fields          ( T );
        probeLocations  ( (0.05 0.01 0.02) );
    }
    settleStop
    {
        type            runTimeControl;
        libs            (utilityFunctionObjects);
        conditions
        {
            settle
            {
                type            average;
                functionObject  ht_wall_heat_flux;
                fields          ( int(heater) );
                tolerance       0.01;
                window          50;
                windowType      approximate;
                log             false;
            }
        }
        satisfiedAction end;
    }
}
