FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    walls
    {
        type          noSlip;
    }
    inlet
    {
        type          surfaceNormalFixedValue;
        refValue          uniform -0.5;
        value          uniform (0 0 0);
    }
    outlet
    {
        type          pressureInletOutletVelocity;
        value          uniform (0 0 0);
    }
    heater
    {
        type          noSlip;
    }
    cold_plate
    {
        type          noSlip;
    }
    lid
    {
        type          noSlip;
    }
    side
    {
        type          symmetry;
    }
}
