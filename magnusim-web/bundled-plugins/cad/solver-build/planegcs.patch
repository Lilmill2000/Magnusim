 // The following solver variant solves a system compound of two subsystems
 // treating the first of them as of higher priority than the second
+// magnusim-spike: sparse SQP for the drag solve, see GCS.h
+int System::solveSparseSQP(SubSystem* subsysA, SubSystem* subsysB, bool isRedundantsolving)
+{
+    VEC_pD plistAB;
+    {
+        VEC_pD plistA, plistB;
+        subsysA->getParamList(plistA);
+        subsysB->getParamList(plistB);
+        std::sort(plistA.begin(), plistA.end());
+        std::sort(plistB.begin(), plistB.end());
+        std::set_union(plistA.begin(),
+                       plistA.end(),
+                       plistB.begin(),
+                       plistB.end(),
+                       std::back_inserter(plistAB));
+    }
+    const int n = int(plistAB.size());
+    const int m = subsysA->cSize();
+    const int k = subsysB->cSize();
+
+    subsysA->redirectParams();
+    subsysB->redirectParams();
+
+    Eigen::VectorXd x(n), xStart(n), x0(n), d(n), corr(n), g(n), resA(m), resB(k);
+    Eigen::VectorXd lambda(m), Dinv(n);
+    subsysB->getParams(plistAB, x);
+    subsysA->getParams(plistAB, x);
+    subsysB->setParams(plistAB, x);
+    xStart = x;
+
+    const double conv = isRedundantsolving ? convergenceRedundant : convergence;
+    const int maxIterNumber =
+        (isRedundantsolving
+             ? (sketchSizeMultiplierRedundant ? maxIterRedundant * n : maxIterRedundant)
+             : (sketchSizeMultiplier ? maxIter * n : maxIter));
+    const double eps = 1e-6;  // minimum-change regularisation of the soft Hessian
+    const double eta = 1e-4;  // Armijo constant
+
+    std::vector<Eigen::Triplet<double>> trA, trB;
+    Eigen::SparseMatrix<double> JA(m, n), JB(k, n);
+    double mu = 0.;
+    double stepNorm = std::numeric_limits<double>::infinity();
+    int itersDone = 0;
+    const char* why = "iterations";
+
+    auto setX = [&](Eigen::VectorXd& v) {
+        subsysA->setParams(plistAB, v);
+        subsysB->setParams(plistAB, v);
+    };
+    auto merit = [&]() {
+        subsysA->calcResidual(resA);
+        return subsysB->error() + mu * resA.lpNorm<1>();
+    };
+    auto giveUp = [&](const char* reason) {
+        if (debugMode == IterationLevel) {
+            std::stringstream stream;
+            stream << "sparseSQP fallback to dense: " << reason << " n=" << n << " m=" << m
+                   << " iter=" << itersDone << "\n";
+            const std::string tmp = stream.str();
+            Console::Log(tmp.c_str());
+        }
+        setX(xStart);
+        subsysA->revertParams();
+        subsysB->revertParams();
+        return -1;
+    };
+
+    Eigen::SimplicialLDLT<Eigen::SparseMatrix<double>> ldlt;
+    for (int iter = 0; iter < maxIterNumber; ++iter) {
+        itersDone = iter + 1;
+        trA.clear();
+        trB.clear();
+        subsysA->calcJacobiTriplets(plistAB, trA);
+        subsysB->calcJacobiTriplets(plistAB, trB);
+        JA.setFromTriplets(trA.begin(), trA.end());
+        JB.setFromTriplets(trB.begin(), trB.end());
+        subsysA->calcResidual(resA);
+        subsysB->calcResidual(resB);
+        g = JB.transpose() * resB;
+
+        // H = JB^T JB + eps I, which must be diagonal (a point drag)
+        Eigen::SparseMatrix<double> H = JB.transpose() * JB;
+        Dinv.setConstant(eps);
+        for (int col = 0; col < H.outerSize(); ++col) {
+            for (Eigen::SparseMatrix<double>::InnerIterator it(H, col); it; ++it) {
+                if (it.row() == it.col()) {
+                    Dinv(col) += it.value();
+                }
+                else if (it.value() != 0.) {
+                    return giveUp("soft Hessian not diagonal");
+                }
+            }
+        }
+        Dinv = Dinv.cwiseInverse();
+
+        Eigen::SparseMatrix<double> ADi;
+        if (m > 0) {
+            ADi = JA * Dinv.asDiagonal();
+            Eigen::SparseMatrix<double> S = ADi * JA.transpose();
+            ldlt.compute(S);
+            if (ldlt.info() != Eigen::Success) {
+                return giveUp("Schur complement not factorisable");
+            }
+            Eigen::VectorXd rhsS = resA - ADi * g;
+            lambda = ldlt.solve(rhsS);
+            if (ldlt.info() != Eigen::Success || !lambda.allFinite()
+                || (S * lambda - rhsS).norm() > 1e-8 * (1. + rhsS.norm())) {
+                return giveUp("Schur complement singular");
+            }
+            d = -Dinv.cwiseProduct(g + JA.transpose() * lambda);
+        }
+        else {
+            lambda.resize(0);
+            d = -Dinv.cwiseProduct(g);
+        }
+
+        if (d.norm() <= conv && subsysA->error() <= smallF) {
+            stepNorm = d.norm();
+            why = "converged";
+            break;
+        }
+
+        // l1 merit line search with one second-order correction
+        mu = std::max(mu, 1.1 * (m > 0 ? lambda.lpNorm<Eigen::Infinity>() : 0.) + 1e-12);
+        const double phi0 = subsysB->error() + mu * resA.lpNorm<1>();
+        const double dphi = g.dot(d) - mu * resA.lpNorm<1>();
+        x0 = x;
+        double alpha = 1.;
+        x = x0 + d;
+        setX(x);
+        double phi = merit();
+        if (phi > phi0 + eta * dphi && m > 0) {
+            // resA now holds the residual at x0 + d
+            Eigen::VectorXd mu2 = ldlt.solve(resA);
+            if (mu2.allFinite()) {
+                corr = -Dinv.cwiseProduct(JA.transpose() * mu2);
+                x = x0 + d + corr;
+                setX(x);
+                phi = merit();
+            }
+        }
+        while (phi > phi0 + eta * alpha * dphi) {
+            alpha *= 0.5;
+            if (alpha < 1e-8) {
+                break;
+            }
+            x = x0 + alpha * d;
+            setX(x);
+            phi = merit();
+        }
+        if (alpha < 1e-8) {
+            x = x0;  // the line search failed; keep the last iterate
+            setX(x);
+            stepNorm = 0.;
+            why = "line search";
+            break;
+        }
+        stepNorm = (x - x0).norm();
+        if (stepNorm <= conv && subsysA->error() <= smallF) {
+            why = "step";
+            break;
+        }
+        double err = subsysA->error();
+        if (err != err) {
+            why = "nan";
+            break;
+        }
+    }
+
+    int ret;
+    if (subsysA->error() <= smallF) {
+        ret = Success;
+    }
+    else if (stepNorm <= conv) {
+        ret = Converged;
+    }
+    else {
+        ret = Failed;
+    }
+    if (debugMode == IterationLevel) {
+        std::stringstream stream;
+        stream << "sparseSQP n=" << n << " m=" << m << " iters=" << itersDone << " stop=" << why
+               << " errA=" << subsysA->error() << " errB=" << subsysB->error() << " ret=" << ret
+               << "\n";
+        const std::string tmp = stream.str();
+        Console::Log(tmp.c_str());
+    }
+    subsysA->revertParams();
+    subsysB->revertParams();
+    return ret;
+}
