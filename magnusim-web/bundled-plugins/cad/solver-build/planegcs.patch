         if (pmapfind != pmap.end()) {
-            for (int i = 0; i < csize; i++) {
-                jacobi(i, j) = clist[i]->grad(pmapfind->second);
+            auto adj = p2c.find(pmapfind->second);
+            if (adj == p2c.end()) {
+                continue;
+            }
+            for (Constraint* constr : adj->second) {
+                jacobi(crow[constr], j) = constr->grad(pmapfind->second);
+            }
+        }
+    }
+}
+
+void SubSystem::calcJacobiTriplets(VEC_pD& params, std::vector<Eigen::Triplet<double>>& trips)
+{
+    // magnusim-spike
+    std::unordered_map<double*, int> col;
+    col.reserve(params.size());
+    for (int j = 0; j < int(params.size()); j++) {
+        MAP_pD_pD::const_iterator pmapfind = pmap.find(params[j]);
+        if (pmapfind != pmap.end()) {
+            col[pmapfind->second] = j;
+        }
+    }
+    for (int i = 0; i < csize; i++) {
+        auto it = c2p.find(clist[i]);
+        if (it == c2p.end()) {
+            continue;
+        }
+        for (double* p : it->second) {
+            auto cj = col.find(p);
+            if (cj != col.end()) {
+                trips.emplace_back(i, cj->second, clist[i]->grad(p));
             }
         }
     }
