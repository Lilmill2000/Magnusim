 void SubSystem::calcJacobi(VEC_pD& params, Eigen::MatrixXd& jacobi)
 {
+    // magnusim-spike: evaluate only the constraints adjacent to each parameter (the others
+    // have a zero derivative), instead of every constraint for every parameter
     jacobi.setZero(csize, params.size());
