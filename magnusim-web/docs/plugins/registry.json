{
  "analysis": [
    {
      "key": "incompressible_steady",
      "label": "Incompressible Fluid Flow",
      "plugin": "builtin",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "turbulence_model": {
            "type": "string",
            "default": "kOmegaSST",
            "enum": [
              "laminar",
              "kEpsilon",
              "kOmegaSST",
              "LRR",
              "SSG"
            ],
            "x-cfddesk": {
              "group": "flow",
              "enum_labels": [
                "Laminar",
                "k-epsilon",
                "k-omega SST",
                "LRR (Reynolds stress)",
                "SSG (Reynolds stress)"
              ]
            },
            "title": "Turbulence model",
            "description": "Which turbulence closure the solver uses. k-omega SST is the general-purpose default and handles walls at any y+. k-epsilon and the Reynolds-stress models (LRR, SSG) use high-Re wall functions (y+ above about 30). Reynolds-stress models suit strong swirl but may need a converged k-epsilon run first. Laminar solves no turbulence at all."
          }
        },
        "additionalProperties": false
      },
      "numerics_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "residual_u": {
            "type": "number",
            "default": 0.0001,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "residuals"
            },
            "title": "Residual U",
            "description": "Convergence target for the velocity and turbulence equations. The run stops early once every residual is below its target; otherwise it runs to the iteration limit."
          },
          "residual_p": {
            "type": "number",
            "default": 0.0001,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "residuals"
            },
            "title": "Residual p",
            "description": "Convergence target for the pressure equation. The run stops early once every residual is below its target."
          },
          "relax_u": {
            "type": "number",
            "default": 0.7,
            "minimum": 0.0,
            "maximum": 1.0,
            "x-cfddesk": {
              "group": "relaxation"
            },
            "title": "Relaxation U",
            "description": "Under-relaxation for the velocity and turbulence equations (0 to 1). Lower is more stable but converges more slowly."
          },
          "relax_p": {
            "type": "number",
            "default": 0.3,
            "minimum": 0.0,
            "maximum": 1.0,
            "x-cfddesk": {
              "group": "relaxation"
            },
            "title": "Relaxation p",
            "description": "Under-relaxation for pressure (0 to 1). SIMPLE usually needs about 0.3; lower it if the solve oscillates or diverges."
          },
          "n_non_orthogonal": {
            "type": "integer",
            "default": 3,
            "minimum": 0,
            "maximum": 20,
            "x-cfddesk": {
              "group": "solution"
            },
            "title": "Non-orthogonal correctors",
            "description": "Extra pressure corrections per iteration for skewed or non-orthogonal cells. 0 is enough for clean hex meshes; tetrahedral meshes usually need 1 to 3."
          }
        },
        "additionalProperties": false
      },
      "control_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "end_time": {
            "type": "number",
            "default": 1000.0,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "End time",
            "description": "Transient: simulated time to stop at, in seconds. Steady: the iteration limit."
          },
          "write_interval": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Write interval",
            "description": "How often results are saved, counted in the unit Write control sets."
          },
          "write_control": {
            "type": "string",
            "default": "timeStep",
            "enum": [
              "timeStep",
              "runTime",
              "adjustableRunTime"
            ],
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Write control",
            "description": "What Write interval counts: time steps, simulated seconds, or simulated seconds with the time step adjusted to land on each write."
          }
        },
        "additionalProperties": false
      },
      "requires": [
        {
          "kind": "wsl_tool",
          "name": "simpleFoam",
          "version_spec": ""
        }
      ],
      "time_dependency": "steady",
      "default_turbulence": "kOmegaSST",
      "default_solver": "simpleFoam",
      "category": "FLUID DYNAMICS",
      "turbulence_models": [
        "laminar",
        "kEpsilon",
        "kOmegaSST",
        "LRR",
        "SSG"
      ]
    },
    {
