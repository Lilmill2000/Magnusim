            "title": "End time",
            "description": "Transient: simulated time to stop at, in seconds. Steady: the iteration limit."
          },
          "delta_t": {
            "type": "number",
            "default": 0.001,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Time step",
            "description": "Simulated seconds per step (the first step when the step adjusts)."
          },
          "write_interval": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Write interval",
            "description": "How often results are saved, counted in the unit Write control sets."
          },
          "write_control": {
            "type": "string",
            "default": "timeStep",
            "enum": [
              "timeStep",
              "runTime",
              "adjustableRunTime"
            ],
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Write control",
            "description": "What Write interval counts: time steps, simulated seconds, or simulated seconds with the time step adjusted to land on each write."
          },
          "max_co": {
            "type": "number",
            "default": 1.0,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "control",
              "advanced": true
            },
            "title": "Max Courant",
            "description": "Largest Courant number allowed when the time step adjusts: how many cells flow may cross in one step. Keep at or below 1 for stability."
          }
        },
        "additionalProperties": false
      },
      "requires": [
        {
          "kind": "wsl_tool",
          "name": "pimpleFoam",
          "version_spec": ""
        }
      ],
      "time_dependency": "transient",
      "default_turbulence": "kOmegaSST",
      "default_solver": "pimpleFoam",
      "category": "FLUID DYNAMICS",
      "turbulence_models": [
        "laminar",
        "kEpsilon",
        "kOmegaSST",
