{
  "name": "magnusim-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Magnusim web app: project setup, geometry, boundary conditions and SimScale-style meshing on OpenFOAM (WSL)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "lint": "eslint scripts src \"bundled-plugins/*/ui/**/*.{ts,tsx}\" --max-warnings 10000",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/server/tsconfig.json && tsc -p tsconfig.src.json && tsc -p tsconfig.plugins.json",
    "test:server": "node --experimental-strip-types --test scripts/server/__tests__/*.test.js scripts/__tests__/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/e2e-suites.mjs --all",
    "test:e2e:fast": "node scripts/e2e-suites.mjs --all --fast",
    "test:e2e:changed": "node scripts/e2e-suites.mjs --changed",
    "test:e2e:core": "playwright test",
    "test:prepare-run-golden": "node scripts/__tests__/compare-js-case.mjs",
    "check:py": "node scripts/python-check.mjs",
    "test:py": "node scripts/python-check.mjs pytest",
    "test": "npm run lint && npm run typecheck && npm run check:py && npm run test:py && npm run test:server && npm run test:unit && npm run gen:registry:check && npm run gen:plugin-sdk:check && npm run gen:plugin-docs:check && npm run test:docs && npm run gen:api && npm run test:prepare-run-golden && npm run test:e2e",
    "gen:api": "node scripts/gen-api.mjs && node scripts/gen-registry-types.mjs",
    "capture:js-case": "node scripts/__tests__/capture-js-case.mjs",
    "test:js-case": "npm run test:prepare-run-golden",
    "gen:registry": "node scripts/gen-registry.mjs",
    "gen:registry:check": "node scripts/gen-registry.mjs --check",
    "gen:plugin-sdk": "node --experimental-strip-types scripts/gen-plugin-sdk.mjs",
    "gen:plugin-sdk:check": "node --experimental-strip-types scripts/gen-plugin-sdk.mjs --check",
    "gen:plugin-docs": "node scripts/gen-plugin-docs.mjs",
    "gen:plugin-docs:check": "node scripts/gen-plugin-docs.mjs --check",
    "test:docs": "node scripts/doc-tests.mjs",
    "plugin:check": "node scripts/plugin-check.mjs",
    "plugin:new": "node scripts/plugin-new.mjs",
    "plugin:pack": "node scripts/plugin-pack.mjs",
    "guard:node-siblings": "node scripts/__tests__/test_no_node_sibling_writes.js",
    "prove:node-siblings": "node scripts/__tests__/prove-no-node-sibling-writes.mjs"
  },
  "dependencies": {
    "@kitware/vtk.js": "^32.12.1",
    "@rjsf/core": "^6.10.0",
    "@rjsf/utils": "^6.10.0",
    "@rjsf/validator-ajv8": "^6.10.0",
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "exports": {
    "./plugin-api": "./src/plugin-api/index.ts",
    "./plugin-ui": "./src/plugin-ui/index.ts"
  },
  "types": "./src/plugin-api/index.ts",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "msw": "^2.15.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "@kitware/vtk.js": {
      "@babel/runtime": "^7.26.10",
      "fflate": "^0.7.5"
    },
    "xmlbuilder2": {
      "js-yaml": "^3.15.2"
    }
  }
}
