{
  "name": "cfd-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Magnusim web app: project setup, geometry, boundary conditions and SimScale-style meshing on OpenFOAM (WSL)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "lint": "eslint scripts src --max-warnings 10000",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/server/tsconfig.json && tsc -p tsconfig.src.json",
    "test:server": "node --experimental-strip-types --test scripts/server/__tests__/*.test.js scripts/__tests__/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:prepare-run-golden": "node scripts/__tests__/compare-js-case.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:server && npm run test:unit && npm run gen:registry:check && npm run gen:api && npm run test:prepare-run-golden && npm run test:e2e",
    "gen:api": "node scripts/gen-api.mjs && node scripts/gen-registry-types.mjs",
    "capture:js-case": "node scripts/__tests__/capture-js-case.mjs",
    "test:js-case": "npm run test:prepare-run-golden",
    "gen:registry": "node scripts/gen-registry.mjs",
    "gen:registry:check": "node scripts/gen-registry.mjs --check",
    "guard:node-siblings": "node scripts/__tests__/test_no_node_sibling_writes.js",
    "prove:node-siblings": "node scripts/__tests__/prove-no-node-sibling-writes.mjs"
  },
  "dependencies": {
    "@kitware/vtk.js": "^32.12.1",
    "@rjsf/core": "^6.10.0",
    "@rjsf/utils": "^6.10.0",
    "@rjsf/validator-ajv8": "^6.10.0",
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "exports": {
    "./plugin-ui": "./src/plugin-api/index.ts"
  },
  "types": "./src/plugin-api/index.ts",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "msw": "^2.15.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "@kitware/vtk.js": {
      "@babel/runtime": "^7.26.10",
      "fflate": "^0.7.5"
    },
    "xmlbuilder2": {
      "js-yaml": "^3.15.2"
    }
  }
}
