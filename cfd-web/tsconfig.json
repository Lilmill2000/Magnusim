{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.js"],
  "exclude": [
    "scripts/__tests__/**",
    "scripts/vite-plugin-case-fields.js",
    "scripts/w16-project-geometry.js",
    "scripts/w21-mesh-generate.js",
    "scripts/w27-solve.js"
  ]
}
