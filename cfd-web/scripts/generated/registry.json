{
  "analysis": [
    {
      "key": "incompressible_steady",
      "label": "Incompressible Fluid Flow",
      "plugin": "builtin",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "turbulence_model": {
            "type": "string",
            "default": "kOmegaSST",
            "enum": [
              "laminar",
              "kEpsilon",
              "kOmegaSST",
              "LRR",
              "SSG"
            ],
            "x-cfddesk": {
              "group": "flow"
            },
            "title": "Turbulence model"
          },
          "passive_species": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 20,
            "x-cfddesk": {
              "group": "flow"
            },
            "title": "Passive species"
          },
          "energy": {
            "type": "boolean",
            "default": false,
            "x-cfddesk": {
              "group": "flow",
              "advanced": true
            },
            "title": "Energy"
          }
        },
        "additionalProperties": false
      },
      "numerics_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "residual_u": {
            "type": "number",
            "default": 1e-06,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "residuals"
            },
            "title": "Residual U"
          },
          "residual_p": {
            "type": "number",
            "default": 1e-06,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "residuals"
            },
            "title": "Residual p"
          },
          "relax_u": {
            "type": "number",
            "default": 0.7,
            "minimum": 0.0,
            "maximum": 1.0,
            "x-cfddesk": {
              "group": "relaxation"
            },
            "title": "Relaxation U"
          },
          "relax_p": {
            "type": "number",
            "default": 0.3,
            "minimum": 0.0,
            "maximum": 1.0,
            "x-cfddesk": {
              "group": "relaxation"
            },
            "title": "Relaxation p"
          },
          "n_non_orthogonal": {
            "type": "integer",
            "default": 1,
            "minimum": 0,
            "x-cfddesk": {
              "group": "solution"
            },
            "title": "Non-orthogonal correctors"
          },
          "ddt_default": {
            "type": "string",
            "default": "steadyState",
            "x-cfddesk": {
              "group": "schemes",
              "advanced": true
            },
            "title": "Time scheme"
          }
        },
        "additionalProperties": false
      },
      "control_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "end_time": {
            "type": "number",
            "default": 1000.0,
            "minimum": 0.0,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "End time"
          },
          "write_interval": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Write interval"
          },
          "write_control": {
            "type": "string",
            "default": "timeStep",
            "enum": [
              "timeStep",
              "runTime",
              "adjustableRunTime"
            ],
            "x-cfddesk": {
              "group": "control"
            },
            "title": "Write control"
          }
        },
        "additionalProperties": false
      },
      "requires": [
        {
          "kind": "wsl_tool",
          "name": "simpleFoam",
          "version_spec": ""
        }
      ],
      "time_dependency": "steady",
      "default_turbulence": "kOmegaSST",
      "default_solver": "simpleFoam",
      "category": "FLUID DYNAMICS",
      "turbulence_models": [
        "laminar",
        "kEpsilon",
        "kOmegaSST",
        "LRR",
        "SSG"
      ]
    },
